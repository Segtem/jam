# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
*.egg-info/

# Unreal (cuando el plugin viva dentro de un proyecto)
Binaries/
Intermediate/
Saved/
DerivedDataCache/
*.VC.db
*.opensdf
*.sdf

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Reference: la GIF de 15MB es pesada para la historia (el PNG/AVIF chicos sí se versionan)
Reference/*.gif

# Material de ayudantes visuales: se fabrica solo la primera vez (jam.materials)
Content/Materials/

# Obsidian: estado local de la UI (cambia en cada sesión, no aporta al repo)
Vault-kb/.obsidian/workspace.json

# El wheel de Oracle vendorizado SÍ va al repositorio: es lo que el intérprete embebido de Unreal
# puede importar, y tenerlo fijado es la razón de vendorizarlo. Su bytecode no: se regenera solo y
# ensucia todo diff posterior con archivos que nadie escribió.
vendor/oracle-pkg/**/__pycache__/
vendor/oracle-pkg/**/*.pyc
