caso scatter-002-interpenetraciones-de-distinta-profundidad:
    fecha: "2026-08-09"
    origen:
        repo: "Brianholl/jam"
        commit: "migracion-scatter-oracle"
    titulo: "La profundidad publicada es la peor de la tanda"
    etiqueta: falso_verde
    sintoma:
        Con un solo choque, resumir por mínimo o máximo publicaba el mismo valor.
    como_se_detecto: mutacion
    medida: scatter.interpenetracion
    evidencia:
        instancia: id, ox, oy, oz, ex, ey, ez
            "a", 0.0, 0.0, 0.0, 25.0, 25.0, 25.0
            "b", 48.0, 0.0, 0.0, 25.0, 25.0, 25.0
            "c", 1000.0, 0.0, 0.0, 25.0, 25.0, 25.0
            "d", 1040.0, 0.0, 0.0, 25.0, 25.0, 25.0
    leccion:
        Un agregado no se fija con una sola fila: hacen falta profundidades distintas.
