caso 008-al-ras-toma-el-peor-contacto:
    fecha: "2026-07-31"
    origen:
        repo: "Brianholl/jam"
        commit: "sombra-snap-al-ras"
    titulo: "Un lote al ras falla si uno de sus objetivos conserva un hueco"
    etiqueta: falso_verde
    sintoma:
        Resumir por mínimo ocultaba el objetivo separado detrás de otro contacto perfecto.
    como_se_detecto: mutacion
    medida: snap.al_ras
    evidencia:
        pieza: id, ox, oy, oz, ex, ey, ez
            "a", 0.0, 0.0, 0.0, 0.0, 50.0, 50.0
        objetivo: id, eje, ox, oy, oz, ex, ey, ez
            "contacto", "x", 0.0, 0.0, 0.0, 0.0, 50.0, 50.0
            "hueco", "x", 2.0, 0.0, 0.0, 0.0, 50.0, 50.0
    leccion:
        La semántica de lote exige el máximo error: todos los contactos solicitados deben quedar al ras.
