requisito snap.cuadrar_a_grilla:
    texto "Las piezas alineadas con snap ajustan su pivote a la grilla y su ángulo yaw al paso angular"
    fuente "Vault-kb/04-Ejecucion-y-pruebas/2026-09-10-GUIA-DSL-De-Jam-v1.0.md"
